# URL da sua API via Cloudflare Tunnel (Ex: https://minha-api-viola.trycloudflare.com)
VITE_API_BASE_URL=

# Chave das rotas de escrita baratas (POST de view, favorito, dificuldade, sync).
#
# É pública por construção: vai no bundle e qualquer pessoa a lê. Por isso guarda só
# o que é barato — e por isso NÃO é a mesma chave de /api/internal/*, que vive apenas
# no servidor e nos workers e nunca deve ser posta neste arquivo.
#
# O prefixo VITE_ é obrigatório: sem ele o Vite não expõe a variável ao cliente, e a
# falha aparece como 403 em produção, não como erro de build.
VITE_VIOLA_PUBLIC_KEY=sua_chave_aqui
