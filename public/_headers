# O script-src enumera todo JavaScript que pode rodar aqui, e cada entrada precisa
# ser software livre ou estar declarada em /jslicense.html — é o que mantém o site
# utilizável com o GNU LibreJS. Acrescentar um host aqui é decidir carregar código
# de terceiro: confira a licença antes.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.violalibre.com.br http://api.roadrunner-arctic.ts.net https://api.roadrunner-arctic.ts.net https://gleitz.github.io; frame-src https://www.youtube.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
